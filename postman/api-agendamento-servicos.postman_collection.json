        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Sobrancelha\",\n  \"duracaoMin\": 15,\n  \"preco\": 20.0,\n  \"categoriaId\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('novoId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Detalhe do serviço cadastrado",
